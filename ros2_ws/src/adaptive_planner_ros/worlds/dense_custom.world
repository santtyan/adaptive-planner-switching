<?xml version="1.0" ?>
<!--
  dense_custom.world — Gazebo Classic world for RL training and benchmark.

  Contains 7 cylindrical obstacles arranged to create dense corridors and
  forcing the robot to navigate around clusters. Global obstacle density ~0.40.

  Coordinate frame: standard Gazebo (x=east, y=north, z=up).
  Robot spawn: set via /gazebo/set_entity_state — not fixed here.
-->
<sdf version="1.6">
  <world name="dense_custom">

    <!-- Physics -->
    <physics type="ode">
      <!-- real_time_update_rate=0 → roda a física tão rápido quanto a CPU permitir
           (destrava o treino RL do limite de 1x wall-clock).
           20/06/2026: max_step_size MANTIDO em 0.001 — testar 0.004 piorou fps 7→1
           (o LIDAR a 5 Hz sim deixa de disparar com passo grosso → step espera o
           SCAN_TIMEOUT=1.0s inteiro). O gargalo NÃO é custo de física, é entrega de scan.
           ODE iters 150→50: redução segura (não afeta timing de sensor). -->
      <real_time_update_rate>0.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Bounding walls (4m x 4m arena) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 1.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 1.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>2.1 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 1.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2.1 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 1.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Cylindrical obstacles — radius 0.18 m, height 1.0 m -->
    <!-- Cluster A: top-left -->
    <model name="obs_0">
      <static>true</static>
      <pose>-1.2 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="obs_1">
      <static>true</static>
      <pose>-0.6 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Cluster B: centre-right -->
    <model name="obs_2">
      <static>true</static>
      <pose>1.0 0.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="obs_3">
      <static>true</static>
      <pose>1.4 -0.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Cluster C: centre diagonal -->
    <model name="obs_4">
      <static>true</static>
      <pose>-0.2 -0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="obs_5">
      <static>true</static>
      <pose>0.5 -1.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Singleton: near centre -->
    <model name="obs_6">
      <static>true</static>
      <pose>-1.0 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- GUI camera -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 8 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
