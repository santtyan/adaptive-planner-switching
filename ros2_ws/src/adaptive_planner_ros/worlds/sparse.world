<?xml version="1.0" ?>
<!--
  sparse.world — Arena 4×4m com 3 obstáculos cilíndricos.
  Densidade global ρ ≈ 0.10 → A* deve ser selecionado na maior parte do mapa.
  Serve como nível 1 de dificuldade na comparação de progressão.
-->
<sdf version="1.6">
  <world name="sparse">

    <physics type="ode">
      <real_time_update_rate>0.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Bounding walls (4m x 4m arena) -->
    <model name="wall_north">
      <static>true</static><pose>0 2.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 1.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -2.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 1.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>2.1 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 1.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-2.1 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 1.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- 3 obstáculos cilíndricos espalhados — ρ ≈ 0.10 -->
    <model name="obs_0">
      <static>true</static>
      <pose>-1.2 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <model name="obs_1">
      <static>true</static>
      <pose>1.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <model name="obs_2">
      <static>true</static>
      <pose>-0.3 -1.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 8 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
